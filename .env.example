# !! .ENV.EXAMPLE IS SAVED IN THE REPOSITORY / .ENV.EXAMPLE EST VERSIONNE!!
# !! DO NOT USE THIS FILE IN PRODUCTION / NE PAS L'UTILISER EN PRODUCTION !!
# 
# Modèle de configuration. Copier en .env.dev ou .env.prod selon l'environnement.

# --- Obligatoire ---

# Signe les cookies de session. Générer une valeur unique par environnement :
#   openssl rand -hex 32
# Laisser une valeur devinable rend n'importe quelle session falsifiable.
TASKINS_SECRET_KEY=changethis

# --- Application ---

TASKINS_DEBUG=false
TASKINS_DB_PATH=/app/data/taskins.db
TASKINS_SSH_KEY_PATH=/app/secrets/taskins_ed25519

# Fréquence du cycle du moteur, en secondes.
TASKINS_SCHEDULER_INTERVAL=10

# Timeout appliqué à une tâche qui n'en définit pas explicitement.
TASKINS_DEFAULT_TASK_TIMEOUT=300

# Fuseau d'interprétation des expressions cron et des dates de planification.
# Le stockage en base reste en UTC.
TASKINS_TIMEZONE=Europe/Paris

# Retard au-delà duquel une occurrence planifiée est considérée manquée et
# ignorée (aucun rattrapage après un arrêt de l'application).
TASKINS_SCHEDULE_GRACE_SECONDS=60

# --- Port publié sur l'hôte ---
# Lu par Docker Compose pour l'interpolation du fichier compose, pas par
# l'application : il doit donc être passé via --env-file (voir README).
# Défauts : 8000 en développement, 80 en production.
TASKINS_HTTP_PORT=8000

# --- Premier démarrage ---

# Compte administrateur créé si et seulement si la table users est vide.
# Sans effet ensuite : le mot de passe se change depuis /account.
TASKINS_BOOTSTRAP_ADMIN_USERNAME=admin
TASKINS_BOOTSTRAP_ADMIN_PASSWORD=changethis

# Machine cible créée au premier démarrage. Si TASKINS_SEED_MACHINE_HOST n'est
# pas renseigné, aucune machine n'est créée et il faut les ajouter depuis
# /admin. Une adresse factice serait pire qu'une absence : elle produirait des
# exécutions en échec sans raison apparente.
TASKINS_SEED_MACHINE_ALIAS=worker-1
TASKINS_SEED_MACHINE_HOST=
TASKINS_SEED_MACHINE_SSH_USER=svc-taskins
TASKINS_SEED_MACHINE_SSH_PORT=22