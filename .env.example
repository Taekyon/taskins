TASKINS_SECRET_KEY=changeme
TASKINS_DEBUG=false
TASKINS_DB_PATH=/app/data/taskins.db
TASKINS_SSH_KEY_PATH=/app/secrets/taskins_ed25519
TASKINS_SCHEDULER_INTERVAL=10

# Timeout (secondes) appliqué à une tâche qui n'en définit pas explicitement.
TASKINS_DEFAULT_TASK_TIMEOUT=300

# Fuseau dans lequel les expressions cron et les dates de planification sont
# interprétées. Le stockage en base reste en UTC.
TASKINS_TIMEZONE=Europe/Paris

# Retard au-delà duquel une occurrence planifiée est considérée manquée et
# ignorée (aucun rattrapage après un arrêt de l'application).
TASKINS_SCHEDULE_GRACE_SECONDS=60

# Bootstrap du premier compte admin — pris en compte uniquement si la table
# users est vide au démarrage. Sans effet ensuite, peut rester en place.
TASKINS_BOOTSTRAP_ADMIN_USERNAME=admin
TASKINS_BOOTSTRAP_ADMIN_PASSWORD=changeme
